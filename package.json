{
  "name": "bescherelle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/prerender.ts",
    "preview": "npx --yes wrangler pages dev dist",
    "test": "vitest run",
    "data": "python3 scripts/fetch_sources.py && python3 scripts/build_data.py",
    "deploy": "npm run build && npx --yes wrangler pages deploy dist --project-name bescherelle --branch main",
    "translate": "python3 scripts/translate_mt.py"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "license": "CC-BY-NC-4.0",
  "engines": {
    "node": ">=23.6"
  }
}
